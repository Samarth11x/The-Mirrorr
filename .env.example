# ==============================================================================
# THE MIRRORR Unisex Hair & Beauty Studio - Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration
# Option 1: Local SQLite (Zero-dependency default for local development & testing)
DATABASE_URL="file:./dev.db"

# Option 2: PostgreSQL (For production or local PostgreSQL server)
# DATABASE_URL="postgresql://username:password@localhost:5432/themirrorr?schema=public"

# Security & Authentication Secrets (Generate secure random strings in production)
JWT_SECRET=the-mirrorr-jwt-dev-secret-change-in-production-12345
SESSION_SECRET=the-mirrorr-session-secret-change-in-production-67890
COOKIE_SECRET=the-mirrorr-cookie-secret-change-in-production-abcdef

# Client URL (For CORS during separate frontend dev server)
CLIENT_URL=http://localhost:5173
